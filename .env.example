# ==========================================================
# SHOPAGENT PRODUCTION & DEVELOPMENT CONFIGURATION TEMPLATE
# ==========================================================

# ----------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ----------------------------------------------------------
POSTGRES_DB=shopagent
POSTGRES_USER=shopagent
POSTGRES_PASSWORD=shopagent_secure_pass_2026
# For Docker Compose (uses internal container hostname "db")
SHOPAGENT_DATABASE_URL=postgresql+psycopg://shopagent:shopagent_secure_pass_2026@db:5432/shopagent
# For Local Bare-Metal (without Docker, uncomment below)
# SHOPAGENT_DATABASE_URL=postgresql+psycopg://shopagent:shopagent_secure_pass_2026@localhost:5432/shopagent

# ----------------------------------------------------------
# 2. Authentication & Security
# ----------------------------------------------------------
SHOPAGENT_JWT_SECRET=shopagent-production-secret-key-32chars-minimum-length-2026
SHOPAGENT_ACCESS_MINUTES=15
SHOPAGENT_REFRESH_DAYS=30
SHOPAGENT_CORS_ORIGINS=*

# ----------------------------------------------------------
# 3. Ports & Service Routing
# ----------------------------------------------------------
SHOPAGENT_API_PORT=8000
SHOPAGENT_WEB_PORT=3000
# Internal URL for Next.js server-side container proxy
BACKEND_INTERNAL_URL=http://backend:8000
# Client-side API URL (leave blank for automatic relative routing)
NEXT_PUBLIC_API_URL=

# ----------------------------------------------------------
# 4. AI & LLM Engine (Optional - Ollama / OpenAI / Open-Source)
# ----------------------------------------------------------
SHOPAGENT_AI_PROVIDER=ollama
SHOPAGENT_OLLAMA_BASE_URL=http://localhost:11434
SHOPAGENT_OLLAMA_MODEL=qwen3:8b

# If using OpenAI or custom OpenAI-compatible API (e.g., Groq, Together, DeepSeek):
SHOPAGENT_AI_API_BASE_URL=https://api.openai.com/v1
SHOPAGENT_AI_API_KEY=
SHOPAGENT_AI_API_MODEL=gpt-4o-mini
SHOPAGENT_AI_TIMEOUT=60

# ----------------------------------------------------------
# 5. Live Search & Live Price Extraction (Optional APIs)
# ----------------------------------------------------------
# Serper.dev API key for live search queries
SHOPAGENT_SERPER_API_KEY=
# Google Custom Search API (Optional alternative to Serper)
SHOPAGENT_GOOGLE_API_KEY=
SHOPAGENT_GOOGLE_CX=
SHOPAGENT_MAX_COMPARISON_SOURCES=8
SHOPAGENT_PLAYWRIGHT_HEADLESS=true
SHOPAGENT_ALLOW_DEMO_SEED=true

# ----------------------------------------------------------
# 6. Push Notifications (Telegram Bot - Optional)
# ----------------------------------------------------------
SHOPAGENT_TELEGRAM_BOT_TOKEN=
SHOPAGENT_TELEGRAM_CHAT_ID=
